// 주기적으로 상태를 가져온다
procedure TfrmMain.syncState;
var
  Client: THTTPClient;
  Resp: IHTTPResponse;
  i: Integer;
  cnt: Integer;
  _state: string;
begin
  if myID = '' then begin
    syncDisabled;
    LOG_ADD(ERROR_CUSTOMER_EMPTY, false);
    MessageDlg(ERROR_CUSTOMER_EMPTY, mtError, [mbOk], 0);
    exit;
  end;

  Client := THTTPClient.Create;
  try
    //Client.UserAgent := 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)'; // 브라우저처럼
    Client.HandleRedirects := True;

    Resp := Client.Get('https://sdtv.kr/timelist/?id=' + myID);
    moState.Text := Resp.ContentAsString;

    if Pos(';HIDE_CREATOR;', moState.Lines[4]) > 0 then begin
      lblSync_creator.visible := False;
    end
    else begin
      lblSync_creator.visible := True;
    end;

    SetConfigValue(CONFIG_FILENAME, 'App', 'Version', moState.lines.Strings[0]);
    cnt := 0;
    for i := 5 to moState.lines.Count-1 do begin
      cnt := cnt + 1;
      SetConfigValue(CONFIG_FILENAME, 'POWEROFF', 'RESERVE'+IntToStr(cnt), moState.lines.Strings[i]);
    end;
  finally
    Client.Free;
  end;

  _state := moState.lines.Strings[1];
  if _state = 'NOT_FOUND' then begin
    syncDisabled;
    LOG_ADD(ERROR_CUSTOMER_NOTFOUND, false);
    for i := 1 to 10 do begin
      SetConfigValue(CONFIG_FILENAME, 'POWEROFF', 'RESERVE'+IntToStr(i), '');
    end;

    MessageDlg(ERROR_CUSTOMER_NOTFOUND, mtError, [mbOk], 0);
  end
  else if _state = 'TASK_SHUTDOWN' then begin
    task_shutdown;
  end
  else if _state = 'TASK_REBOOT' then begin
    task_reboot;
  end
  else if _state = 'TASK_RELOAD' then begin
    task_reload;
  end
  else if _state = 'TASK_STOP' then begin
    task_stop;
  end
  else if _state = 'POWEROFF' then begin
    powerOff;
  end
  else if _state = 'ACTIVE' then begin
    if not onceExec then begin
      menu_run;
      onceExec := True;
    end;
  end;
end;

