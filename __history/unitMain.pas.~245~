procedure TfrmMain.LOG_ADD(content: string; blankYN: boolean);
var
  AFile: TStringList;
  AFileName: string;
begin
  content := '['+DatetimeToStr(now)+'] ' + content;
  AFile := TStringList.Create;
  AFileName := myPath + 'logs.txt';
  if FileExists(AFileName) then
    AFile.LoadFromFile(AFileName);

  if blankYN then
    AFile.Insert(0, '---')
  else
    AFile.Insert(0, content);

  AFile.SaveToFile(AFileName);
  FreeAndNil(AFile);
end;

