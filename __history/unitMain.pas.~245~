procedure TfrmMain.task_done;
var
  Client: THTTPClient;
  Resp: IHTTPResponse;
  i: Integer;
  cnt: Integer;
  _state: string;
begin
  if myID = '' then begin
    exit;
  end;

  Client := THTTPClient.Create;
  try
    //Client.UserAgent := 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)'; // 브라우저처럼
    Client.HandleRedirects := True;
    Resp := Client.Get('https://sdtv.kr/task/?id=' + myID + '&task=done');
  finally
    Client.Free;
  end;
end;

procedure TfrmMain.task_reboot;
begin
