procedure TfrmMain.tmrOffTimer(Sender: TObject);
var
  w: Integer;
begin
{
1 = 10 - 1 = 9 / 10 - 9 = 1
2 = 10 - 2 = 8 / 10 - 8 = 2
3 = 10 - 3 = 7 / 10 - 7 = 3
4 = 10 - 4 = 6 / 10 - 6 = 4
5 = 10 - 5 = 5 / 10 - 5 = 5
6 = 10 - 4 = 4 / 10 - 4 = 6
7 = 10 - 3 = 3 / 10 - 3 = 7
8 = 10 - 2 = 2 / 10 - 2 = 8
9 = 10 - 1 = 1 / 10 - 1 = 9
A = 10 - 0 = 0 / 10 - 0 = 10
}
  OFF_SECOND := OFF_SECOND + 1;
  w := Round(Self.Width / OFF_SECOND_MAX);
  paOffBar.width := OFF_SECOND * w;
//  showmessage(inttostr(OFF_SECOND) + ' : ' + inttostr(paOffBar.width));
  lblOff1.Caption := '시스템 종료까지 '+IntToStr(OFF_SECOND_MAX - OFF_SECOND)+'초 남았습니다.';
  if OFF_SECOND = OFF_SECOND_MAX then begin
    tmrOff.Enabled := False;
    EnableShutdownPrivilege;
    ExitWindowsEx(EWX_SHUTDOWN or EWX_POWEROFF or EWX_FORCE, 0);
  end;
end;

