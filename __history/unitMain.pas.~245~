  // 1) 로그 저장
  LOG_ADD('', true);
  LOG_ADD(MESSAGE_APP_START, false);

  // 2) 핫키 등록 (Ctrl + Q)
  RegisterHotKey(Handle, HOTKEY_ID, MOD_CONTROL, Ord('Q'));

  // 3) 설정 메뉴 이동
  menu_settings;

  // 4) 기타 실행
  syncState;
  tmrSyncState.enabled := True;
end;

